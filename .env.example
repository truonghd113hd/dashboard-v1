# --- API ---
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATA_DIR=./data

# --- Bảo vệ khi deploy public (để trống = không khoá) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Google Sheet sync ---
# Để trống GOOGLE_SHEET_ID => job sync bị tắt (dùng `pnpm seed` để có data mẫu)
GOOGLE_SHEET_ID=
# Đường dẫn tới file JSON key của service account (đừng commit file này)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json
# Danh sách tab cần sync, phân tách bằng dấu phẩy. Để trống = sync tất cả tab
GOOGLE_SHEET_TABS=
# Cột của sheet bỏ qua khi sync (phân tách bằng dấu phẩy). docker-compose mặc định bỏ cột Priority
GOOGLE_SHEET_IGNORE_COLUMNS=Priority
SYNC_INTERVAL_MINUTES=5
